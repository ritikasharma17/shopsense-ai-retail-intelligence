# ========================================================
# ShopSense Configuration Environment Variables
# Copy this file to .env to configure local settings.
# None of these are required to run the core application.
# ========================================================

# Optional: Google Gemini API Key for Ask ShopSense AI synthesis.
# If omitted, ShopSense operates seamlessly using its built-in
# deterministic analytical reasoning engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Application Environment (development / production)
SHOPSENSE_ENV=development

# Streamlit Port & Debug
STREAMLIT_SERVER_PORT=8501
SHOPSENSE_DEBUG=false
